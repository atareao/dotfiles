fish_add_path -g ~/.cargo/bin ~/.local/bin ~/go/bin/ ~/bin /usr/local/bin

if status is-interactive
    # Commands to run in interactive sessions can go here
    # remove welcome message
    set -g fish_greeting
    # set starship config
    set -gx STARSHIP_CONFIG ~/.config/starship/starship.toml
    # set neovim as editor
    set -gx EDITOR nvim
    # Theme
    fish_config theme choose "ayu Mirage"
    # starship
    starship init fish | source
    # zoxide
    zoxide init fish | source
    # direnv
    direnv hook fish | source
    # uv
    uv generate-shell-completion fish | source
    # fclones
    fclones complete fish | source
    # rbw (bitwarden unofficial cli)
    rbw gen-completions fish | source
    # skim
    sk --shell fish | source
    # variables
    {% if env.MACHINE == "archi" -%}
    set -gx MACHINE archi
    set -gx TERM kitty
    # Load crypta keys cleanly
    if type -q crypta
        # Silence stderr in case crypta prints warning/header messages
        for key in (crypta ls 2>/dev/null)
            # Verify $key contains only valid characters (letters, numbers, underscores)
            if string match -qr '^[a-zA-Z0-9_]+$' -- $key
                set -l value (crypta lookup $key 2>/dev/null)
                # Only export if lookup succeeded and returned a non-empty value
                if test -n "$value"
                    set -l key_up (string upper $key)
                    set -gx $key_up $value
                end
            end
        end
    end
    {% elif env.MACHINE == "termux" -%}
    set -gx MACHINE termux
    {% endif -%}
end

# pnpm
set -gx PNPM_HOME "/home/lorenzo/.local/share/pnpm"
if not string match -q -- $PNPM_HOME $PATH
  set -gx PATH "$PNPM_HOME" $PATH
end
