# =============================================================================
# Ghostty Configuration — Generated by goose
# =============================================================================
# OS: Linux — All keybinds use ctrl+shift prefix
# Docs: https://ghostty.org/docs/configuration
# =============================================================================

# ---------------------------------------------------------------------------
# THEME & APPEARANCE
# ---------------------------------------------------------------------------
theme = Ayu
cursor-invert-fg-bg = true
minimum-contrast = 1.05
mouse-hide-while-typing = true
background-opacity = 0.95
cursor-style = bar

# ---------------------------------------------------------------------------
# FONT
# ---------------------------------------------------------------------------
font-family = "Iosevka Nerd Font"
font-style = Medium
font-style-bold = Bold
font-style-italic = Medium Italic
font-style-bold-italic = Bold Italic
font-size = 12

# ---------------------------------------------------------------------------
# SHELL & INTEGRATION
# ---------------------------------------------------------------------------
shell-integration = fish
term = xterm-256color
copy-on-select = clipboard
right-click-action = paste
bell-features = border

# =============================================================================
# KEYBOARD SHORTCUTS — Linux (ctrl+shift prefix)
# =============================================================================
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+w=close_tab:this
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+left=resize_split:left,10
keybind = ctrl+shift+down=resize_split:down,10
keybind = ctrl+shift+up=resize_split:up,10
keybind = ctrl+shift+right=resize_split:right,10
keybind = ctrl+shift+plus=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+slash=start_search
keybind = ctrl+shift+f=toggle_fullscreen
keybind = ctrl+shift+i=toggle_quick_terminal
keybind = ctrl+shift+,=reload_config

# =============================================================================
# ADDITIONAL KEYBINDINGS (uncomment to enable)
# =============================================================================
keybind = ctrl+shift+tab=next_tab
# keybind = ctrl+shift+grave=previous_tab
# keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+0=reset_font_size
