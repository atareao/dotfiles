{
    "edit_predictions": {
        "provider": "zed"
    },
    "project_panel": {
        "dock": "left"
    },
    "outline_panel": {
        "dock": "left"
    },
    "collaboration_panel": {
        "dock": "left"
    },
    "git_panel": {
        "dock": "left"
    },
    "icon_theme": "Colored Zed Icons Theme Dark",
    "wrap_guides": [
        80,
        120
    ],
    "agent": {
        "dock": "right",
        "model_parameters": [],
        "default_model": {
            "provider": "zed.dev",
            "model": "claude-sonnet-4"
        },
    },
    "vim_mode": true,
    "buffer_font_family": "IosevkaTerm Nerd Font Mono",
    "ui_font_size": 16,
    "buffer_font_size": 16,
    "show_whitespaces": "boundary",
    "relative_line_numbers": "enabled",
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "Ayu Mirage"
    },
    "inlay_hints": {
        "enabled": true
    },
    "autosave": "on_focus_change",
    "format_on_save": "on",
    "languages": {
        "Python": {
            "code_actions_on_format": {
                "source.organizeImports.ruff": true,
                "source.fixAll.ruff": true
            },
            "language_servers": [
                "ruff"
            ],
            "format_on_save": "on",
            "formatter": []
        }
    },
    "lsp": {
        "basedpyright": {
            "settings": {
                "basedpyright.analysis.inlayHints.variableTypes": true,
                "basedpyright.analysis.inlayHints.callArgumentNames": true,
                "basedpyright.analysis.inlayHints.functionReturnTypes": true
            }
        },
        "ruff": {
            "initialization_options": {
                "settings": {
                    "lineLength": 80,
                    "lint": {
                        "extendSelect": [
                            "I"
                        ]
                    }
                }
            }
        },
        "rust-analyzer": {
            "initialization_options": {
                "inlayHints": {
                    "maxLength": null,
                    "lifetimeElisionHints": {
                        "enable": "skip_trivial",
                        "useParameterNames": true
                    },
                    "closureReturnTypeHints": {
                        "enable": "always"
                    }
                }
            }
        }
    },
    "context_servers": {
        "codebase-memory-mcp": {
            "command": "/home/lorenzo/.local/bin/codebase-memory-mcp",
            "args": [
                ""
            ]
        }
    }
}
